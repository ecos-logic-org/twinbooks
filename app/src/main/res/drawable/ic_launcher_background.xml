<?xml version="1.0" encoding="utf-8"?>
<!-- Diagonal blue (English) to green (second language) gradient. The ends differ in
     luminance (~3:1), not just hue, so they stay distinguishable with color vision
     deficiencies; the middle band behind the navy book frame keeps >=3.5:1 against it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0H108V108H0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#2962FF" />
                <item android:offset="1" android:color="#00E676" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
